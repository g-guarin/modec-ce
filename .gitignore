# Resultados locales: se regeneran con los comandos del README. Los pilotos con proveedor
# pueden contener datos de facturación; publíquelos solo a propósito, en `evidencia/`.
resultados/

# Entornos y cachés
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/

# Secretos (nunca deben llegar al repositorio)
.env
.env.*
*.key
*.pem
*.secret

# Excepción deliberada: los certificados públicos de la autoridad de sellado de tiempo SÍ se
# publican junto al ancla. No son secretos —cualquiera los descarga de la autoridad— y si esa
# autoridad dejara de estar disponible, quien quiera verificar el sello los necesitaría. Sin esta
# excepción, la regla `*.pem` de arriba los excluiría en silencio.
!sello/**/*.pem
!sello/**/*.crt

# Borradores de trabajo locales
BORRADOR_*.md
